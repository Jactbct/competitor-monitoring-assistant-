# ---- 运行 ----
APP_ENV=dev
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_TIMEZONE=Asia/Shanghai

# ---- 数据库 ----
# 留空 = 本地 SQLite（仅开发/演示）；生产必须 PostgreSQL：
#   postgresql://app_rw:app_rw_password@127.0.0.1:5432/competitor
DATABASE_URL=

# ---- 采集 ----
# 出口硬上限。只能改这个文件并重启，不提供后台旋钮（合规要求）
COLLECTOR_QPS=1
# fixture = 读本地样本页（演示/联调，不产生外部请求）
# http    = 真实只读抓取，必须合规评审通过才能开
COLLECTOR_MODE=fixture
COLLECTOR_UA=TaobaoCompetitorMonitor/0.1 (+mailto:ops@example.com)
COLLECTOR_TIMEOUT_S=12
COLLECTOR_MAX_BYTES=3000000
ROBOTS_ENFORCE=1
COLLECTOR_FIXTURE_DIR=tests/fixtures/pages

# ---- LLM ----
# off = 纯规则引擎（默认，无密钥也能跑通全链路）；openai = 兼容 OpenAI 协议的网关
LLM_MODE=off
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL_EXTRACT=small
LLM_MODEL_REASON=mid
LLM_PROMPT_VERSION=p1
LLM_DAILY_TOKEN_QUOTA=2000000

# ---- 业务闸门 ----
# 一期默认关闭 B 类（跟价）自动推送：M1 实测到手价可确定率 ≥70% 再打开
B_CLASS_ENABLED=0

# ---- 通知 ----
WECOM_WEBHOOK=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=alert@example.com
DIGEST_HOUR=9

# ---- 存储 ----
RAW_STORE_DIR=./.data/raw
RAW_RETENTION_DAYS=7
# 结构化快照保留天数（≥30；400 天约覆盖一年同比）
SNAPSHOT_RETENTION_DAYS=400

# ---- worker ----
WORKER_CONCURRENCY=2
WORKER_SCHEDULER=1
